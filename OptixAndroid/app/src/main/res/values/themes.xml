<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Optix" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Optix.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#070710</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Optix</item>
    </style>

</resources>
