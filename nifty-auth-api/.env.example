# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/optix_auth

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET_KEY=your-super-secret-key-min-32-chars-long-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# SMS Provider (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# SMS Provider Alternative (MSG91 for India)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# Social OAuth - Google
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# Social OAuth - Apple
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=XXXXXXXXXX
APPLE_CLIENT_ID=com.yourcompany.optix
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Social OAuth - Facebook
FACEBOOK_APP_ID=123456789
FACEBOOK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Upstox API (for live market data)
UPSTOX_API_KEY=your-upstox-api-key
UPSTOX_API_SECRET=your-upstox-api-secret
UPSTOX_REDIRECT_URI=http://localhost:8000/api/v1/market/upstox/callback

# App Configuration
APP_NAME=Optix
ENVIRONMENT=development
DEBUG=true

# Rate Limiting
OTP_MAX_ATTEMPTS=3
OTP_EXPIRE_MINUTES=5
OTP_RATE_LIMIT_PER_HOUR=3

# AI Chatbot
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
